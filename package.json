{
  "name": "bhe-pta",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "build": "react-router build",
    "cf-typegen": "wrangler types",
    "dev": "react-router dev",
    "postinstall": "pnpm run cf-typegen",
    "preview": "pnpm run build && vite preview",
    "prod:deploy": "pnpm run build && wrangler deploy",
    "prod:migrate": "wrangler d1 migrations apply pta-reimbursement-db --remote",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "pnpm run cf-typegen && react-router typegen && tsc -b",
    "refresh": "curl -s -X POST https://bheeagles.com/api/refresh -H \"Authorization: Bearer $DATA_REFRESH_SECRET\" | jq ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1032.0",
    "@aws-sdk/s3-request-presigner": "^3.1032.0",
    "@sentry/cloudflare": "^10.49.0",
    "@sentry/react": "^10.49.0",
    "cheerio": "^1.2.0",
    "fflate": "^0.8.2",
    "ical.js": "^2.2.1",
    "isbot": "^5.1.39",
    "jspdf": "^4.2.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "7.14.1",
    "resend": "^6.12.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@cloudflare/vite-plugin": "^1.32.3",
    "@react-router/dev": "7.14.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.83.0"
  }
}
