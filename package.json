{
  "name": "bhe-pta",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "build": "react-router build",
    "cf-typegen": "wrangler types",
    "dev": "react-router dev",
    "dev:migrate": "wrangler d1 migrations apply pta-reimbursement-db --local",
    "dev:migrations:list": "wrangler d1 migrations list pta-reimbursement-db --local",
    "postinstall": "pnpm run cf-typegen",
    "preview": "pnpm run build && vite preview",
    "prod:deploy": "pnpm run build && wrangler deploy",
    "prod:migrate": "wrangler d1 migrations apply pta-reimbursement-db --remote",
    "stage:deploy": "pnpm run build && wrangler deploy --env stage",
    "stage:migrate": "wrangler d1 migrations apply REIMBURSEMENT_DB --remote --env stage",
    "stage:tail": "wrangler tail --env stage",
    "stage:secret": "wrangler secret put --env stage",
    "stage:secret:bulk": "wrangler secret bulk --env stage",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "pnpm run cf-typegen && react-router typegen && tsc -b",
    "refresh": "curl -s -X POST https://bheeagles.com/api/refresh -H \"Authorization: Bearer $DATA_REFRESH_SECRET\" | jq ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@sentry/cloudflare": "^10.53.1",
    "@sentry/react": "^10.53.1",
    "cheerio": "^1.2.0",
    "fflate": "^0.8.2",
    "ical.js": "^2.2.1",
    "isbot": "^5.1.40",
    "jspdf": "^4.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "7.15.0",
    "resend": "^6.12.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@cloudflare/vite-plugin": "^1.36.4",
    "@react-router/dev": "7.15.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.6",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.6",
    "wrangler": "^4.90.1"
  }
}
