{
  "name": "bhe-pta",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "build": "react-router build",
    "cf-typegen": "wrangler types",
    "dev": "react-router dev",
    "postinstall": "pnpm run cf-typegen",
    "preview": "pnpm run build && vite preview",
    "prod:deploy": "pnpm run build && wrangler deploy",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "typecheck": "pnpm run cf-typegen && react-router typegen && tsc -b",
    "refresh": "curl -s -X POST https://bheeagles.com/api/refresh -H \"Authorization: Bearer $SESSION_SECRET\" | jq ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.995.0",
    "@aws-sdk/s3-request-presigner": "^3.995.0",
    "cheerio": "^1.2.0",
    "ical.js": "^2.2.1",
    "isbot": "^5.1.35",
    "jspdf": "^3.0.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "7.12.0",
    "resend": "^4.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@cloudflare/vite-plugin": "^1.25.2",
    "@react-router/dev": "7.12.0",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^22.19.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.30.6",
    "drizzle-orm": "^0.38.4",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^4.67.0"
  }
}
